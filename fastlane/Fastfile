default_platform(:mac)

platform :mac do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  def review_contact
    {
      first_name: ENV.fetch("REVIEW_CONTACT_FIRST_NAME"),
      last_name: ENV.fetch("REVIEW_CONTACT_LAST_NAME"),
      email_address: ENV.fetch("REVIEW_CONTACT_EMAIL"),
      phone_number: ENV.fetch("REVIEW_CONTACT_PHONE"),
      demo_user: "",
      demo_password: "",
      notes: File.read(File.expand_path("review_notes.txt", __dir__)).strip
    }
  end

  def wait_for_processed_build(version:, build:, timeout: 3600)
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found in App Store Connect") unless app
    deadline = Time.now + timeout
    loop do
      found = Spaceship::ConnectAPI::Build.all(
        app_id: app.id, version: version, build_number: build.to_s, platform: Spaceship::ConnectAPI::Platform::MAC_OS
      ).first
      state = found&.processing_state
      UI.message("Build #{version} (#{build}): #{state || 'not visible yet'}")
      return found if state == Spaceship::ConnectAPI::Build::ProcessingState::VALID
      UI.user_error!("Build #{build} failed processing: #{state}") if %w[FAILED INVALID].include?(state)
      UI.user_error!("Timed out waiting for build #{build}") if Time.now > deadline
      sleep(30)
    end
  end

  desc "Upload metadata, screenshots and release notes and submit a processed build for review"
  lane :release do |options|
    version = options.fetch(:version)
    build = options.fetch(:build)
    submit = options.fetch(:submit, "true").to_s == "true"
    key = api_key
    wait_for_processed_build(version: version, build: build)
    withdraw_from_review(version: version) if submit
    deliver(
      api_key: key,
      platform: "osx",
      app_version: version,
      build_number: build.to_s,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      app_review_information: review_contact,
      app_rating_config_path: "./fastlane/metadata/age_rating.json",
      force: true,
      submit_for_review: submit,
      automatic_release: true,
      reject_if_possible: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  def withdraw_from_review(version:, timeout: 900)
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found in App Store Connect") unless app
    platform = Spaceship::ConnectAPI::Platform::MAC_OS
    submission = app.get_in_progress_review_submission(platform: platform)
    return unless submission
    UI.message("Cancelling review submission #{submission.id} (#{submission.state})")
    submission.cancel_submission
    deadline = Time.now + timeout
    loop do
      current = app.get_edit_app_store_version(platform: platform)
      state = current&.app_store_state
      UI.message("Version #{version}: #{state}")
      break if app.get_in_progress_review_submission(platform: platform).nil? && %w[DEVELOPER_REJECTED PREPARE_FOR_SUBMISSION REJECTED].include?(state)
      UI.user_error!("Timed out waiting for the review submission to be cancelled") if Time.now > deadline
      sleep(20)
    end
  end

  desc "Replace the screenshots of an App Store version and resubmit it for review"
  lane :screenshots do |options|
    version = options.fetch(:version)
    submit = options.fetch(:submit, "true").to_s == "true"
    key = api_key
    withdraw_from_review(version: version) if submit
    deliver(
      api_key: key,
      platform: "osx",
      app_version: version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      screenshots_path: "./fastlane/screenshots",
      force: true,
      submit_for_review: submit,
      reject_if_possible: submit,
      automatic_release: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      app_review_information: review_contact,
      app_rating_config_path: "./fastlane/metadata/age_rating.json",
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Check that the App Store Connect credentials and app record work"
  lane :verify do
    key = api_key
    app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
    UI.user_error!("App not found in App Store Connect") unless app
    UI.success("Found #{app.name} (#{app.id})")
    latest = Spaceship::ConnectAPI::Build.all(app_id: app.id, platform: Spaceship::ConnectAPI::Platform::MAC_OS, sort: "-uploadedDate", limit: 1).first
    UI.success("Latest build: #{latest&.app_version} (#{latest&.version}) #{latest&.processing_state}")
    probe = Spaceship::ConnectAPI::Build.all(app_id: app.id, version: latest&.app_version, build_number: latest&.version, platform: Spaceship::ConnectAPI::Platform::MAC_OS).first
    UI.success("Lookup by version and build: #{probe&.processing_state}")
  end
end
