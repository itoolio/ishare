    "promotional_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الآن مع تراكبات كاميرا الويب وضغطات المفاتيح، وقص التسجيلات، والأختام وتسليط الضوء، والرفع إلى وجهات متعددة، ومجلد المراقبة، وسجل قابل للبحث."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neu: Webcam- und Tastatur-Overlays, Aufnahmen kürzen, Stempel und Spotlight, Uploads an mehrere Ziele, ein überwachter Ordner und ein durchsuchbarer Verlauf."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora con superposición de cámara web y teclas, recorte de grabaciones, sellos y foco, subidas a varios destinos, carpeta vigilada e historial con búsqueda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau : incrustation webcam et touches, découpe des enregistrements, tampons et projecteur, envoi multi-destination, dossier surveillé et historique consultable."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Now with webcam and keystroke overlays, recording trim, stamps and spotlight, multi-destination uploads, a watch folder and searchable history."
