    "Answer a few questions and Apple Intelligence builds the uploader on your Mac." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أجب عن بضعة أسئلة وسيُنشئ Apple Intelligence أداة الرفع على جهاز Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beantworte ein paar Fragen und Apple Intelligence erstellt den Uploader auf deinem Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Responde unas preguntas y Apple Intelligence creará el cargador en tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Répondez à quelques questions et Apple Intelligence crée l'uploader sur votre Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ सवालों के जवाब दें और Apple Intelligence आपके Mac पर अपलोडर बना देगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いくつかの質問に答えるだけで、Apple IntelligenceがMac上でアップローダーを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "몇 가지 질문에 답하면 Apple Intelligence가 Mac에서 업로더를 만들어 줍니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birkaç soruyu yanıtlayın, Apple Intelligence yükleyiciyi Mac'inizde oluştursun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дайте відповідь на кілька запитань, і Apple Intelligence створить завантажувач на вашому Mac."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回答几个问题，Apple Intelligence 即可在你的 Mac 上构建上传器。"
          }
        }
      }
    },
    "Answers are based on the text and objects ishare recognizes" : {
      "localizations" : {
