    "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند تشغيل السؤال في كل مرة، يعرض ishare هذه الخيارات قبل كل رفع إلى أداة الرفع هذه. تُحفظ كلمة السر الافتراضية في سلسلة المفاتيح."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn „Jedes Mal fragen“ aktiviert ist, zeigt ishare diese Optionen vor jedem Upload zu diesem Uploader an. Das Standardpasswort wird in deinem Schlüsselbund gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si “Preguntar siempre” está activado, ishare muestra estas opciones antes de cada subida a este servicio. La contraseña por omisión se guarda en tu llavero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque « Toujours demander » est activé, ishare affiche ces options avant chaque envoi vers ce service. Le mot de passe par défaut est conservé dans votre trousseau."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
