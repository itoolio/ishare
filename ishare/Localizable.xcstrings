          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON रिस्पॉन्स से मान डालने के लिए {{path.to.value}} का उपयोग करें, या सादे टेक्स्ट रिस्पॉन्स के लिए {{response}} का।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSONレスポンスの値を挿入するには{{path.to.value}}を、プレーンテキストのレスポンスには{{response}}を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON 응답의 값을 삽입하려면 {{path.to.value}}를, 일반 텍스트 응답에는 {{response}}를 사용합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON yanıtındaki değerleri eklemek için {{path.to.value}}, düz metin yanıtı için {{response}} kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте {{path.to.value}}, щоб вставити значення з JSON-відповіді, або {{response}} для текстової відповіді."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 {{path.to.value}} 插入 JSON 响应中的值，或使用 {{response}} 表示纯文本响应。"
          }
        }
      }
    },
    "Use {{response}} for a plain-text reply or a JSON path such as {{data.short}}." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم {{response}} للرد بنص عادي أو مسار JSON مثل {{data.short}}."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende {{response}} für eine Klartextantwort oder einen JSON-Pfad wie {{data.short}}."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa {{response}} para una respuesta en texto plano o una ruta JSON como {{data.short}}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez {{response}} pour une réponse en texte brut ou un chemin JSON tel que {{data.short}}."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सादे टेक्स्ट जवाब के लिए {{response}} या {{data.short}} जैसा JSON पाथ इस्तेमाल करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーンテキストの応答には {{response}} を、JSONの場合は {{data.short}} のようなパスを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일반 텍스트 응답에는 {{response}}를, JSON에는 {{data.short}} 같은 경로를 사용합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Düz metin yanıt için {{response}} veya {{data.short}} gibi bir JSON yolu kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте {{response}} для простої текстової відповіді або шлях JSON, як-от {{data.short}}."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纯文本响应请使用 {{response}}，或使用 JSON 路径，例如 {{data.short}}。"
          }
        }
      }
    },
    "Use {{url}} for the uploaded URL or {{url_encoded}} for it percent-encoded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم {{url}} لـ URL المرفوع أو {{url_encoded}} له بترميز النسبة المئوية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende {{url}} für die hochgeladene URL oder {{url_encoded}} für die prozentkodierte Version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa {{url}} para la URL subida o {{url_encoded}} para su versión con codificación porcentual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez {{url}} pour l’URL envoyée ou {{url_encoded}} pour sa version encodée en pourcentage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपलोड किए गए URL के लिए {{url}} या उसके प्रतिशत-एन्कोडेड रूप के लिए {{url_encoded}} इस्तेमाल करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロードしたURLには {{url}} を、パーセントエンコードしたURLには {{url_encoded}} を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드된 URL에는 {{url}}을, 퍼센트 인코딩된 URL에는 {{url_encoded}}를 사용합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklenen URL için {{url}}, yüzde kodlamalı hâli için {{url_encoded}} kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте {{url}} для URL вивантаження або {{url_encoded}} для нього у відсотковому кодуванні."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 {{url}} 表示上传后的 URL，或使用 {{url_encoded}} 表示其百分号编码形式。"
          }
        }
      }
    },
    "Use “ishare upload”, “ishare capture region” and more from Terminal, scripts and launchers like Raycast." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم «ishare upload» و«ishare capture region» وغيرها من Terminal والبرامج النصية وأدوات التشغيل مثل Raycast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende „ishare upload“, „ishare capture region“ und mehr im Terminal, in Skripten und in Launchern wie Raycast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa “ishare upload”, “ishare capture region” y más desde Terminal, scripts y lanzadores como Raycast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez « ishare upload », « ishare capture region » et plus encore depuis Terminal, des scripts et des lanceurs comme Raycast."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminal, स्क्रिप्ट और Raycast जैसे लॉन्चर से “ishare upload”, “ishare capture region” और बहुत कुछ उपयोग करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ターミナル、スクリプト、Raycastなどのランチャーから「ishare upload」や「ishare capture region」などを使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "터미널, 스크립트 및 Raycast 같은 런처에서 ‘ishare upload’, ‘ishare capture region’ 등을 사용할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ishare upload”, “ishare capture region” ve daha fazlasını Terminal’den, betiklerden ve Raycast gibi başlatıcılardan kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте «ishare upload», «ishare capture region» та інші команди з Термінала, скриптів і лаунчерів на кшталт Raycast."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“终端”、脚本以及 Raycast 等启动器中使用“ishare upload”、“ishare capture region”等命令。"
          }
        }
      }
    },
