          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ローカルネットワークで共有」は、同じネットワーク上のデバイスだけが開ける一時的なリンクで、このMacからファイルを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘로컬 네트워크에서 공유’는 같은 네트워크의 기기에서만 열 수 있는 임시 링크로 이 Mac의 파일을 제공합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open."
          }
        },
        "no" : {
          "stringUnit" : {
