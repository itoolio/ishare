          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vollbild- und Bereichsaufnahmen enthalten nur den Ton dieser Apps. Bei Aufnahmen eines einzelnen Fensters oder einer App wird immer der Ton dieser App verwendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
