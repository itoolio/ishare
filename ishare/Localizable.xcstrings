    "ishare remembers a fingerprint of each file it uploads on this Mac. When you upload the same file to the same uploader again and its link is still in your history, ishare can copy the existing link instead." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers a fingerprint of each file it uploads on this Mac. When you upload the same file to the same uploader again and its link is still in your history, ishare can copy the existing link instead."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتذكر ishare بصمة كل ملف يرفعه على جهاز Mac هذا. عندما ترفع الملف نفسه إلى أداة الرفع نفسها مرة أخرى ويكون رابطه لا يزال في السجل، يمكن لـ ishare نسخ الرابط الموجود بدلًا من ذلك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers a fingerprint of each file it uploads on this Mac. When you upload the same file to the same uploader again and its link is still in your history, ishare can copy the existing link instead."
          }
        },
        "cs" : {
