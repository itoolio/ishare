    "Links, titles, alt text and deletion links of your latest 200 uploads are kept in sync between your Macs. Files stay on each Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم مزامنة الروابط والعناوين والنص البديل وروابط الحذف لآخر 200 عملية رفع بين أجهزة Mac لديك. تبقى الملفات على كل جهاز Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links, Titel, Alt-Texte und Löschlinks deiner letzten 200 Uploads werden zwischen deinen Macs synchronisiert. Die Dateien bleiben auf dem jeweiligen Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces, títulos, textos alternativos y enlaces de eliminación de tus últimas 200 subidas se sincronizan entre tus Mac. Los archivos se quedan en cada Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens, titres, textes alternatifs et liens de suppression de vos 200 derniers envois sont synchronisés entre vos Mac. Les fichiers restent sur chaque Mac."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके नवीनतम 200 अपलोड के लिंक, शीर्षक, ऑल्ट टेक्स्ट और डिलीट लिंक आपके Mac के बीच सिंक रहते हैं। फ़ाइलें हर Mac पर ही रहती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新200件のアップロードのリンク、タイトル、代替テキスト、削除リンクがMac間で同期されます。ファイル自体は各Macに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 200개 업로드의 링크, 제목, 대체 텍스트 및 삭제 링크가 Mac 간에 동기화됩니다. 파일은 각 Mac에 그대로 유지됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son 200 yüklemenin bağlantıları, başlıkları, alternatif metinleri ve silme bağlantıları Mac’lerin arasında eşzamanlanır. Dosyalar her Mac’te kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посилання, заголовки, альтернативний текст і посилання для видалення ваших останніх 200 вивантажень синхронізуються між вашими Mac. Файли залишаються на кожному Mac."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近 200 次上传的链接、标题、替代文本和删除链接会在你的各台 Mac 之间保持同步。文件仍保留在各台 Mac 上。"
          }
        }
      }
    },
    "Load a custom uploader shared by your server or a friend." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حمّل أداة رفع مخصصة يشاركها خادمك أو أحد أصدقائك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade einen eigenen Uploader, den dein Server oder ein Freund teilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga un servicio de subida personalizado compartido por tu servidor o un amigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chargez un service d'envoi personnalisé partagé par votre serveur ou un ami."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने सर्वर या किसी मित्र द्वारा शेयर किया गया कस्टम अपलोडर लोड करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバや友人が共有したカスタムアップローダを読み込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버나 친구가 공유한 사용자 지정 업로더를 불러옵니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucunuzun veya bir arkadaşınızın paylaştığı özel bir yükleyiciyi yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
