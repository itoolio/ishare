          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare lädt ein 1×1-Pixel-Bild hoch und löscht es wieder oder kontaktiert nur den Server, wenn der Uploader keine Dateien löschen kann. Prüfungen werden bei Akkustand unter 20% sowie im Modus „Wenig Daten“ oder in getakteten Netzwerken übersprungen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
