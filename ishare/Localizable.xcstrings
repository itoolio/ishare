    "Some hosts reject AVIF or WebP. Choose “Keep the format” for them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترفض بعض الخدمات AVIF أو WebP. اختر «الإبقاء على التنسيق» لها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Hosts lehnen AVIF oder WebP ab. Wähle für sie „Format beibehalten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos servicios rechazan AVIF o WebP. Elige “Mantener el formato” para ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains hébergeurs refusent l'AVIF ou le WebP. Choisissez « Conserver le format » pour eux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ होस्ट AVIF या WebP अस्वीकार करते हैं। उनके लिए “फ़ॉर्मेट रखें” चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AVIFやWebPを受け付けないホストもあります。その場合は「フォーマットを維持」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부 호스트는 AVIF 또는 WebP를 거부합니다. 이러한 호스트에는 ‘포맷 유지’를 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bazı sunucular AVIF veya WebP’yi reddeder. Bunlar için “Biçimi koru”yu seç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Деякі хости не приймають AVIF або WebP. Виберіть для них «Зберегти формат»."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "某些主机不接受 AVIF 或 WebP。请为它们选择“保留格式”。"
          }
        }
      }
    },
