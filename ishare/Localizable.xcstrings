    "A preset bundles a destination, extra destinations, a URL shortener and after-capture overrides. Give it a shortcut to capture a region with it." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A preset bundles a destination, extra destinations, a URL shortener and after-capture overrides. Give it a shortcut to capture a region with it."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع الإعداد المسبق وجهةً ووجهات إضافية وأداة اختصار URL وتجاوزات ما بعد الالتقاط. عيّن له اختصارًا لالتقاط منطقة به."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
