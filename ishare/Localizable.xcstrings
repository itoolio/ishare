    "Take Photo, Scan Documents or Add Sketch with a nearby iPhone or iPad" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقاط صورة أو مسح مستندات أو إضافة رسم باستخدام iPhone أو iPad قريب"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem iPhone oder iPad in der Nähe ein Foto aufnehmen, Dokumente scannen oder eine Skizze hinzufügen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer foto, escanear documentos o añadir dibujo con un iPhone o iPad cercano"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prendre une photo, numériser des documents ou ajouter un croquis avec un iPhone ou iPad à proximité"
