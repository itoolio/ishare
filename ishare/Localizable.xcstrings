          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare sube una imagen de 1×1 píxeles y la vuelve a eliminar, o solo contacta con el servidor si el servicio de subida no puede eliminar archivos. Las comprobaciones se omiten con la batería por debajo del 20% y en redes medidas o en modo de datos reducidos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare uploads a 1×1 pixel image and deletes it again, or only contacts the server when the uploader can't delete files. Checks are skipped on battery below 20% and on Low Data Mode or metered networks."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare envoie une image de 1×1 pixel puis la supprime, ou contacte seulement le serveur si le service d'envoi ne peut pas supprimer de fichiers. Les vérifications sont ignorées sur batterie sous 20% et en mode données réduites ou sur réseau limité."
          }
        },
