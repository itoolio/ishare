    "Hold this key when a capture starts or a recording stops to pick the uploader for it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مع الاستمرار على هذا المفتاح عند بدء الالتقاط أو إيقاف التسجيل لاختيار أداة الرفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte diese Taste beim Start einer Aufnahme oder beim Stoppen einer Bildschirmaufnahme gedrückt, um den Uploader dafür auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada esta tecla al iniciar una captura o detener una grabación para elegir el servicio de subida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez cette touche au début d'une capture ou à la fin d'un enregistrement pour choisir son service d'envoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैप्चर शुरू होने या रिकॉर्डिंग रुकने पर उसका अपलोडर चुनने के लिए यह कुंजी दबाए रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャプチャの開始時または収録の停止時にこのキーを押したままにすると、アップローダを選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캡처를 시작하거나 기록을 중단할 때 이 키를 누르고 있으면 업로더를 선택할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama başladığında veya kayıt durduğunda yükleyiciyi seçmek için bu tuşu basılı tutun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Утримуйте цю клавішу на початку знімка або під час зупинки запису, щоб вибрати для нього вивантажувач."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在捕捉开始或录制停止时按住此键，即可为其选择上传器。"
          }
        }
      }
    },
