    "The %@ link option can't be sent as form data with a binary body" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن إرسال خيار الرابط %@ كبيانات نموذج مع متن ثنائي"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Linkoption %@ kann bei einem binären Body nicht als Formulardaten gesendet werden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La opción de enlace de %@ no se puede enviar como datos de formulario con un cuerpo binario"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'option de lien %@ ne peut pas être envoyée comme données de formulaire avec un corps binaire"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ लिंक विकल्प को बाइनरी बॉडी के साथ फ़ॉर्म डेटा के रूप में नहीं भेजा जा सकता"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@のリンクオプションは、バイナリ本文ではフォームデータとして送信できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 링크 옵션은 바이너리 본문과 함께 폼 데이터로 전송할 수 없습니다"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ bağlantı seçeneği, ikili gövdeyle form verisi olarak gönderilemez"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Параметр посилання «%@» не можна надіслати як дані форми з двійковим тілом запиту"
