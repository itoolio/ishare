        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पास के iPhone या iPad से फ़ोटो लें, दस्तावेज़ स्कैन करें या स्केच जोड़ें"
          }
        },
        "ja" : {
          "stringUnit" : {
