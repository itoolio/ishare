    "Every uploader is available in the Shortcuts app as an “Upload with ishare” action." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتوفر كل أداة رفع في تطبيق الاختصارات كإجراء ”الرفع باستخدام ishare“."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Uploader ist in der Kurzbefehle-App als Aktion „Mit ishare hochladen“ verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los cargadores están disponibles en la app Atajos como acción “Subir con ishare”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque uploader est disponible dans l'app Raccourcis sous forme d'action « Envoyer avec ishare »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर अपलोडर शॉर्टकट ऐप में “ishare से अपलोड करें” क्रिया के रूप में उपलब्ध है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアップローダーは、ショートカットAppで“ishareでアップロード”アクションとして使用できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 업로더는 단축어 앱에서 ‘ishare로 업로드’ 동작으로 사용할 수 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm yükleyiciler Kestirmeler uygulamasında “ishare ile Yükle” eylemi olarak kullanılabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен завантажувач доступний у програмі «Швидкі команди» як дія «Вивантажити за допомогою ishare»."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个上传器都可以在“快捷指令” App 中作为“使用 ishare 上传”操作使用。"
          }
        }
      }
    },
