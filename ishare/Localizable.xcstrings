    "All uploads are removed from your history. Files stay on the server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة جميع عمليات الرفع من السجل. تبقى الملفات على الخادم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Uploads werden aus deinem Verlauf entfernt. Die Dateien bleiben auf dem Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán todas las subidas del historial. Los archivos permanecerán en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les envois sont supprimés de l'historique. Les fichiers restent sur le serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी अपलोड आपके इतिहास से हटा दिए जाएँगे। फ़ाइलें सर्वर पर बनी रहेंगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアップロードが履歴から削除されます。ファイルはサーバに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 업로드가 기록에서 제거됩니다. 파일은 서버에 남아 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm yüklemeler geçmişinizden kaldırılır. Dosyalar sunucuda kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Усі вивантаження буде вилучено з історії. Файли залишаться на сервері."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有上传都将从历史记录中移除。文件仍保留在服务器上。"
          }
        }
      }
    },
