    "Subfolder placeholders: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. Without a public URL, ishare copies the file URL. Public URL placeholders: {{filename}}, {{path}}, {{subfolder}}." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العناصر النائبة للمجلد الفرعي: {{date}}، {{year}}، {{month}}، {{day}}، {{name}}، {{ext}}، {{uuid}}، {{random}}، {{timestamp}}. بدون عنوان URL عام، ينسخ ishare عنوان URL للملف. العناصر النائبة لعنوان URL العام: {{filename}}، {{path}}، {{subfolder}}."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platzhalter für Unterordner: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. Ohne öffentliche URL kopiert ishare die Datei-URL. Platzhalter für die öffentliche URL: {{filename}}, {{path}}, {{subfolder}}."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marcadores de subcarpeta: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. Sin una URL pública, ishare copia la URL del archivo. Marcadores de URL pública: {{filename}}, {{path}}, {{subfolder}}."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variables du sous-dossier : {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. Sans URL publique, ishare copie l'URL du fichier. Variables de l'URL publique : {{filename}}, {{path}}, {{subfolder}}."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सबफ़ोल्डर प्लेसहोल्डर: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}। सार्वजनिक URL के बिना, ishare फ़ाइल URL कॉपी करता है। सार्वजनिक URL प्लेसहोल्डर: {{filename}}, {{path}}, {{subfolder}}।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブフォルダのプレースホルダ:{{date}}、{{year}}、{{month}}、{{day}}、{{name}}、{{ext}}、{{uuid}}、{{random}}、{{timestamp}}。公開URLがない場合、ishareはファイルURLをコピーします。公開URLのプレースホルダ:{{filename}}、{{path}}、{{subfolder}}。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하위 폴더 플레이스홀더: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. 공개 URL이 없으면 ishare가 파일 URL을 복사합니다. 공개 URL 플레이스홀더: {{filename}}, {{path}}, {{subfolder}}."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alt klasör yer tutucuları: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. Genel URL olmadan ishare dosya URL'sini kopyalar. Genel URL yer tutucuları: {{filename}}, {{path}}, {{subfolder}}."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заповнювачі підпапки: {{date}}, {{year}}, {{month}}, {{day}}, {{name}}, {{ext}}, {{uuid}}, {{random}}, {{timestamp}}. Без публічної URL-адреси ishare копіює URL-адресу файлу. Заповнювачі публічної URL-адреси: {{filename}}, {{path}}, {{subfolder}}."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "子文件夹占位符：{{date}}、{{year}}、{{month}}、{{day}}、{{name}}、{{ext}}、{{uuid}}、{{random}}、{{timestamp}}。未设置公共 URL 时，ishare 会复制文件 URL。公共 URL 占位符：{{filename}}、{{path}}、{{subfolder}}。"
          }
        }
      }
    },
