    "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر موعد حذف الملفات المرفوعة في إعدادات كل أداة رفع. تبقى الملفات المرفوعة منتهية الصلاحية في السجل بعلامة “منتهية الصلاحية — حُذفت من الخادم” ما لم توقف هذا الخيار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege in den Einstellungen jedes Uploaders fest, wann Uploads gelöscht werden. Abgelaufene Uploads bleiben mit der Markierung „Abgelaufen – vom Server gelöscht“ im Verlauf, sofern du dies nicht deaktivierst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuándo se eliminan las subidas en los ajustes de cada servicio de subida. Las subidas caducadas permanecen en el historial marcadas como “Caducada — eliminada del servidor”, a menos que desactives esta opción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez quand les envois sont supprimés dans les réglages de chaque service d'envoi. Les envois expirés restent dans l'historique avec la mention « Expiré — supprimé du serveur », sauf si vous désactivez cette option."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose when uploads are deleted in each uploader's settings. Expired uploads stay in your history marked “Expired — deleted from server” unless you turn this off."
          }
        },
