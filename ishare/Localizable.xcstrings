    "The app needs to close to apply the language change. Please reopen the app after it closes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب إغلاق التطبيق لتطبيق تغيير اللغة. يُرجى إعادة فتح التطبيق بعد إغلاقه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App muss geschlossen werden, um die Sprachänderung zu übernehmen. Bitte öffne die App danach erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app debe cerrarse para aplicar el cambio de idioma. Vuelve a abrirla cuando se cierre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app doit se fermer pour appliquer le changement de langue. Veuillez la rouvrir une fois fermée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भाषा परिवर्तन लागू करने के लिए ऐप को बंद होना होगा। कृपया बंद होने के बाद ऐप फिर से खोलें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語の変更を適用するには、Appを終了する必要があります。終了後にAppを再度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언어 변경을 적용하려면 앱을 종료해야 합니다. 앱이 종료된 후 다시 열어 주십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dil değişikliğinin uygulanması için uygulamanın kapanması gerekiyor. Kapandıktan sonra lütfen uygulamayı yeniden açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Програму потрібно закрити, щоб застосувати зміну мови. Відкрийте програму знову після її закриття."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App 需要关闭以应用语言更改。请在关闭后重新打开 App。"
          }
        }
      }
    },
