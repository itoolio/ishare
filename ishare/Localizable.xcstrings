    "Links, titles, alt text and deletion links of your latest 200 uploads are kept in sync between your Macs. Files stay on each Mac." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Links, titles, alt text and deletion links of your latest 200 uploads are kept in sync between your Macs. Files stay on each Mac."
