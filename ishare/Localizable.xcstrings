        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "延迟适用于屏幕和窗口捕获。指针旁会显示倒计时；按下 Esc 即可取消，即使你已点按进入其他 App 也是如此。"
          }
