    "ishare can't write to the folder of “%@”. Choose the folder again in Settings > Uploaders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لـ ishare الكتابة في مجلد “%@”. اختر المجلد مرة أخرى في الإعدادات > أدوات الرفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare kann nicht in den Ordner von „%@“ schreiben. Wähle den Ordner in „Einstellungen“ > „Uploader“ erneut aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare no puede escribir en la carpeta de “%@”. Vuelve a seleccionar la carpeta en Ajustes > Servicios de subida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare ne peut pas écrire dans le dossier de « %@ ». Choisissez à nouveau le dossier dans Paramètres > Services d'envoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare “%@” के फ़ोल्डर में नहीं लिख सकता। सेटिंग्स > अपलोडर में फ़ोल्डर फिर से चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishareは“%@”のフォルダに書き込めません。「設定」>「アップローダ」でフォルダを選択し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare가 “%@”의 폴더에 쓸 수 없습니다. 설정 > 업로더에서 폴더를 다시 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare, “%@” klasörüne yazamıyor. Ayarlar > Yükleyiciler'de klasörü yeniden seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare не може записувати в папку «%@». Виберіть папку ще раз у меню «Налаштування» > «Вивантажувачі»."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare 无法写入“%@”的文件夹。请在“设置”>“上传器”中重新选取文件夹。"
          }
        }
      }
    },
    "ishare couldn't recognize any text or objects" : {
      "localizations" : {
        "ar" : {
