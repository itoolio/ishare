    "The image is copied instead because “Copy image to clipboard instead of URL” is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم نسخ الصورة بدلاً من ذلك لأن خيار “نسخ الصورة إلى الحافظة بدلاً من URL” قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stattdessen wird das Bild kopiert, da „Bild statt URL in die Zwischenablage kopieren“ aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se copia la imagen porque “Copiar imagen al portapapeles en lugar de la URL” está activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'image est copiée à la place, car « Copier l'image dans le presse-papiers au lieu de l'URL » est activé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके बजाय इमेज कॉपी की जाती है क्योंकि “URL के बजाय इमेज क्लिपबोर्ड पर कॉपी करें” चालू है।"
          }
        },
        "ja" : {
          "stringUnit" : {
