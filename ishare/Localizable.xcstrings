    "Ed25519 and RSA keys in OpenSSH format are supported. The key is stored in your Keychain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفاتيح Ed25519 وRSA بتنسيق OpenSSH مدعومة. يُخزَّن المفتاح في سلسلة المفاتيح."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ed25519- und RSA-Schlüssel im OpenSSH-Format werden unterstützt. Der Schlüssel wird in deinem Schlüsselbund gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se admiten claves Ed25519 y RSA en formato OpenSSH. La clave se guarda en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés Ed25519 et RSA au format OpenSSH sont prises en charge. La clé est stockée dans votre trousseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH फ़ॉर्मेट में Ed25519 और RSA कुंजियाँ समर्थित हैं। कुंजी आपके कीचेन में संग्रहीत होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH形式のEd25519鍵とRSA鍵に対応しています。鍵はキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH 형식의 Ed25519 및 RSA 키를 지원합니다. 키는 키체인에 저장됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenSSH biçimindeki Ed25519 ve RSA anahtarları desteklenir. Anahtar, Anahtar Zinciri’nde saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підтримуються ключі Ed25519 і RSA у форматі OpenSSH. Ключ зберігається у вашій В’язці ключів."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支持 OpenSSH 格式的 Ed25519 和 RSA 密钥。密钥存储在你的钥匙串中。"
          }
        }
      }
    },
