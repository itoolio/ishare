          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converted recordings keep the GIF frame rate and size. Uploads are converted on the way out, so the saved video stays as it is."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konvertierte Aufnahmen behalten die GIF-Bildrate und -Größe. Uploads werden beim Hochladen konvertiert, das gesicherte Video bleibt unverändert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converted recordings keep the GIF frame rate and size. Uploads are converted on the way out, so the saved video stays as it is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones convertidas mantienen la frecuencia de fotogramas y el tamaño del GIF. Las subidas se convierten al enviarse, por lo que el vídeo guardado no cambia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converted recordings keep the GIF frame rate and size. Uploads are converted on the way out, so the saved video stays as it is."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements convertis conservent la fréquence d'images et la taille du GIF. Les envois sont convertis au moment de l'envoi, la vidéo enregistrée reste donc inchangée."
          }
        },
