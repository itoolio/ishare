          }
        }
      }
    },
    "They will be deleted from the server and removed from your history. This can’t be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذفها من الخادم وإزالتها من السجل. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie werden vom Server gelöscht und aus deinem Verlauf entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán del servidor y de tu historial. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils seront supprimés du serveur et retirés de votre historique. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन्हें सर्वर से हटा दिया जाएगा और आपके इतिहास से निकाल दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバから削除され、履歴からも取り除かれます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 삭제되고 기록에서도 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunucudan silinecek ve geçmişinizden kaldırılacaklar. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Їх буде видалено із сервера та вилучено з історії. Цю дію не можна скасувати."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它们将从服务器删除并从历史记录中移除。此操作无法撤销。"
          }
        }
      }
    },
