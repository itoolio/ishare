          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Vorgabe bündelt ein Ziel, weitere Ziele, einen URL-Kürzer und abweichende Einstellungen nach der Aufnahme. Weise ihr einen Kurzbefehl zu, um damit einen Bereich aufzunehmen."
          }
        },
        "el" : {
