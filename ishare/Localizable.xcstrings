    "Every upload also goes to these destinations. The URL from your active uploader is the one that gets copied." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم إرسال كل عملية رفع إلى هذه الوجهات أيضاً. يتم نسخ URL من أداة الرفع النشطة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Upload geht auch an diese Ziele. Kopiert wird die URL deines aktiven Uploaders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada subida también se envía a estos destinos. Se copia la URL del servicio de subida activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque envoi est aussi transmis à ces destinations. C'est l'URL du service d'envoi actif qui est copiée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर अपलोड इन गंतव्यों पर भी जाता है। आपके सक्रिय अपलोडर का URL ही कॉपी किया जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのアップロードはこれらのアップロード先にも送信されます。コピーされるのは、使用中のアップローダの URL です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 업로드는 이 대상에도 전송됩니다. 복사되는 URL은 활성 업로더의 URL입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her yükleme bu hedeflere de gönderilir. Kopyalanan URL, etkin yükleyicinizin URL'sidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожне вивантаження також надсилається до цих місць. Копіюється URL від активного вивантажувача."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次上传也会发送到这些目的位置。拷贝的是当前上传器返回的 URL。"
          }
        }
      }
    },
