          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare merkt sich auf diesem Mac einen Fingerabdruck jeder hochgeladenen Datei. Lädst du dieselbe Datei erneut beim selben Uploader hoch und ihr Link ist noch im Verlauf, kann ishare stattdessen den vorhandenen Link kopieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers a fingerprint of each file it uploads on this Mac. When you upload the same file to the same uploader again and its link is still in your history, ishare can copy the existing link instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare recuerda una huella de cada archivo que sube desde este Mac. Si vuelves a subir el mismo archivo al mismo servicio de subida y su enlace sigue en el historial, ishare puede copiar el enlace existente en su lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers a fingerprint of each file it uploads on this Mac. When you upload the same file to the same uploader again and its link is still in your history, ishare can copy the existing link instead."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare mémorise une empreinte de chaque fichier envoyé depuis ce Mac. Lorsque vous envoyez à nouveau le même fichier au même service d'envoi et que son lien figure toujours dans votre historique, ishare peut copier le lien existant à la place."
          }
