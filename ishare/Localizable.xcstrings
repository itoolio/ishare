        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Im lokalen Netzwerk teilen“ stellt eine Datei von diesem Mac über einen temporären Link bereit, den nur Geräte im selben Netzwerk öffnen können."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir en la red local sirve un archivo desde este Mac en un enlace temporal que solo pueden abrir los dispositivos de la misma red."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Partager sur le réseau local » met à disposition un fichier de ce Mac via un lien temporaire que seuls les appareils du même réseau peuvent ouvrir."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open."
          }
        },
