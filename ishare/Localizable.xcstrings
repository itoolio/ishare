        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When Ask every time is on, ishare shows these options before each upload to this uploader. The default password is kept in your Keychain."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「毎回確認」がオンのとき、ishareはこのアップローダへのアップロード前に毎回これらのオプションを表示します。デフォルトのパスワードはキーチェーンに保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'매번 묻기'가 켜져 있으면 ishare는 이 업로더로 업로드할 때마다 이 옵션을 먼저 표시합니다. 기본 비밀번호는 키체인에 보관됩니다."
          }
        },
