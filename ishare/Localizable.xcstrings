    "Refreshing the sign-in failed. Sign in again in the uploader settings. (%@)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل تحديث تسجيل الدخول. سجّل الدخول مجددًا من إعدادات أداة الرفع. (%@)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anmeldung konnte nicht erneuert werden. Melde dich in den Uploader-Einstellungen erneut an. (%@)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido renovar el inicio de sesión. Vuelve a iniciar sesión en los ajustes del cargador. (%@)"
