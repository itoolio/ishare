    "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدّم ميزة «المشاركة على الشبكة المحلية» ملفًا من جهاز Mac هذا عبر رابط مؤقت لا يمكن فتحه إلا من الأجهزة على الشبكة نفسها."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
