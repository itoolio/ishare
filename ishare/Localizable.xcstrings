    "ishare uploads a 1×1 pixel image and deletes it again, or only contacts the server when the uploader can't delete files. Checks are skipped on battery below 20% and on Low Data Mode or metered networks." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare uploads a 1×1 pixel image and deletes it again, or only contacts the server when the uploader can't delete files. Checks are skipped on battery below 20% and on Low Data Mode or metered networks."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرفع ishare صورة بحجم 1×1 بكسل ثم يحذفها، أو يتصل بالخادم فقط إذا كانت أداة الرفع لا تستطيع حذف الملفات. يتم تخطي الفحوصات عندما تكون البطارية أقل من 20% وعلى شبكات وضع البيانات المنخفضة أو الشبكات المحدودة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare uploads a 1×1 pixel image and deletes it again, or only contacts the server when the uploader can't delete files. Checks are skipped on battery below 20% and on Low Data Mode or metered networks."
