    "Without a public URL the upload is saved to history but no link is copied." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدون رابط عام، يُحفظ الملف المرفوع في السجل لكن لا يُنسخ أي رابط."
          }
        },
        "de" : {
          "stringUnit" : {
