            "value" : "ينشئ ishare رابط مشاركة عامًا لكل عملية رفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare erstellt für jeden Upload einen öffentlichen Freigabelink."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare crea un enlace público para cada subida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare crée un lien de partage public pour chaque envoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare हर अपलोड के लिए एक सार्वजनिक शेयर लिंक बनाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishareはアップロードごとに公開共有リンクを作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare는 업로드할 때마다 공개 공유 링크를 생성합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare her yükleme için herkese açık bir paylaşım bağlantısı oluşturur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare створює публічне посилання для кожного вивантаження."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare 会为每次上传创建一个公开共享链接。"
          }
        }
      }
    },
    "ishare creates a view-only sharing link for each upload." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ ishare رابط مشاركة للعرض فقط لكل عملية رفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare erstellt für jeden Upload einen Freigabelink nur zum Ansehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare crea un enlace de solo lectura para cada subida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare crée un lien de partage en lecture seule pour chaque envoi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare हर अपलोड के लिए केवल देखने योग्य शेयर लिंक बनाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
