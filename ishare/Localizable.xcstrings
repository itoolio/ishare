    "“%@” isn't signed in. Edit the uploader and sign in again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تسجيل الدخول إلى «%@». عدّل أداة الرفع وسجّل الدخول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist nicht angemeldet. Bearbeite den Uploader und melde dich erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no tiene la sesión iniciada. Edita el cargador y vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » n'est pas connecté. Modifiez l'uploader et reconnectez-vous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” में साइन इन नहीं है। अपलोडर संपादित करें और फिर से साइन इन करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はサインインしていません。アップローダを編集して、もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’에 로그인되어 있지 않습니다. 업로더를 편집하여 다시 로그인하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” oturum açmamış. Yükleyiciyi düzenleyip yeniden giriş yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для «%@» не виконано вхід. Відредагуйте вивантажувач і увійдіть знову."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”未登录。请编辑上传器并重新登录。"
          }
        }
      }
    },
    "“%@” was also changed on another Mac. Both versions were kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير “%@” أيضاً على Mac آخر. تم الاحتفاظ بكلتا النسختين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wurde auch auf einem anderen Mac geändert. Beide Versionen wurden behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” también se modificó en otro Mac. Se han conservado ambas versiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » a aussi été modifié sur un autre Mac. Les deux versions ont été conservées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” किसी दूसरे Mac पर भी बदला गया था। दोनों संस्करण रखे गए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は別の Mac でも変更されました。両方のバージョンが保持されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’이(가) 다른 Mac에서도 변경되었습니다. 두 버전이 모두 유지되었습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” başka bir Mac'te de değiştirildi. Her iki sürüm de saklandı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» також змінено на іншому Mac. Обидві версії збережено."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”也在另一台 Mac 上被更改。两个版本均已保留。"
          }
        }
      }
    },
    "“%@” will be deleted from the server and removed from your history. This can’t be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف “%@” من الخادم وإزالته من السجل. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ wird vom Server gelöscht und aus deinem Verlauf entfernt. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” se eliminará del servidor y del historial. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » sera supprimé du serveur et retiré de l'historique. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” सर्वर से हटा दिया जाएगा और आपके इतिहास से निकाल दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はサーバから削除され、履歴からも削除されます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’이(가) 서버에서 삭제되고 기록에서 제거됩니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” sunucudan silinecek ve geçmişinizden kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» буде видалено із сервера та вилучено з історії. Цю дію не можна скасувати."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”将从服务器删除并从历史记录中移除。此操作无法撤销。"
          }
        }
      }
    },
    "“Increase contrast” is turned on in Accessibility settings, so the menu already uses high contrast." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار “زيادة التباين” مفعّل في إعدادات تسهيلات الاستخدام، لذا تستخدم القائمة تباينًا عاليًا بالفعل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Kontrast erhöhen“ ist in den Bedienungshilfen aktiviert, daher verwendet das Menü bereits hohen Kontrast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Aumentar contraste” está activado en los ajustes de Accesibilidad, así que el menú ya usa alto contraste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Augmenter le contraste » est activé dans les réglages d’accessibilité ; le menu utilise donc déjà un contraste élevé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सुलभता सेटिंग्स में “कंट्रास्ट बढ़ाएँ” चालू है, इसलिए मेनू पहले से ही उच्च कंट्रास्ट का उपयोग करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティ設定で“コントラストを上げる”がオンになっているため、メニューはすでに高コントラストです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손쉬운 사용 설정에서 ‘대비 증가’가 켜져 있어 메뉴가 이미 고대비로 표시됩니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erişilebilirlik ayarlarında “Karşıtlığı artır” açık, bu nedenle menü zaten yüksek kontrast kullanıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У налаштуваннях Доступності ввімкнено «Збільшити контраст», тому меню вже використовує високий контраст."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辅助功能设置中已开启“增强对比度”，因此菜单已使用高对比度。"
          }
        }
      }
    },
    "↑↓ to choose · ↩ to run · esc to close" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ للاختيار · ↩ للتشغيل · esc للإغلاق"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "↑↓ zum Auswählen · ↩ zum Ausführen · esc zum Schließen"
