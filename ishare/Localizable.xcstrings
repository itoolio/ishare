        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesin sessiz kaldığı ve görüntünün neredeyse hiç değişmediği bölümleri bulur, ardından bunları kaldırır veya daha hızlı oynatır. “Kayıtları kaydetmeden önce kırp” açıkken kırpma penceresi, herhangi bir değişiklik yapılmadan önce kesimleri zaman çizelgesinde gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знаходить фрагменти, де звук тихий, а зображення майже не змінюється, і видаляє їх або прискорює. Якщо ввімкнено «Обрізати записи перед збереженням», вікно обрізання покаже вирізи на шкалі часу ще до будь-яких змін."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finds stretches where the audio stays quiet and the picture barely changes, then removes them or plays them faster. With “Trim recordings before saving” on, the trim window shows the cuts on the timeline before anything is changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查找音频保持安静且画面几乎不变的片段，然后将其移除或加速播放。开启“存储前修剪录制内容”后，修剪窗口会在进行任何更改前在时间线上显示剪切部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Finds stretches where the audio stays quiet and the picture barely changes, then removes them or plays them faster. With “Trim recordings before saving” on, the trim window shows the cuts on the timeline before anything is changed."
          }
        }
      }
