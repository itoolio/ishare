        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“在本地网络上共享”会通过临时链接从这台 Mac 提供文件，只有同一网络中的设备才能打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
