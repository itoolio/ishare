          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones de pantalla completa y de región solo incluyen el sonido de estas apps. Al grabar una sola ventana o app, siempre se usa el sonido de esa app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Full-screen and region recordings only include sound from these apps. Recording a single window or app always uses that app's sound."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements en plein écran et de zone n'incluent que le son de ces apps. L'enregistrement d'une seule fenêtre ou app utilise toujours le son de cette app."
          }
        },
        "he" : {
          "stringUnit" : {
