    "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينطبق التأخير على لقطات الشاشة والنوافذ. يظهر عدّ تنازلي بجانب المؤشر؛ اضغط Esc لإلغائه، حتى بعد النقر في تطبيق آخر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verzögerung gilt für Bildschirm- und Fensteraufnahmen. Neben dem Zeiger erscheint ein Countdown; drücke Esc, um ihn abzubrechen, auch nachdem du in eine andere App geklickt hast."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El retardo se aplica a las capturas de pantalla y de ventana. Aparece una cuenta atrás junto al puntero; pulsa Esc para cancelarla, incluso después de hacer clic en otra app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The delay applies to screen and window captures. A countdown appears next to the pointer; press Esc to cancel it, even after you click into another app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le délai s'applique aux captures d'écran et de fenêtre. Un compte à rebours apparaît à côté du pointeur ; appuyez sur Échap pour l'annuler, même après avoir cliqué dans une autre app."
          }
