    "%@ can't host .%@ files. Choose a custom uploader instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن لـ %@ استضافة ملفات .%@. اختر أداة رفع مخصصة بدلاً من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann keine .%@-Dateien hosten. Wähle stattdessen einen eigenen Uploader."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede alojar archivos .%@. Elige un servicio de subida personalizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas héberger les fichiers .%@. Choisissez plutôt un service d'envoi personnalisé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ .%@ फ़ाइलें होस्ट नहीं कर सकता। इसके बजाय कोई कस्टम अपलोडर चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は .%@ ファイルをホストできません。代わりにカスタムアップローダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서는 .%@ 파일을 호스팅할 수 없습니다. 대신 사용자 지정 업로더를 선택하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ .%@ dosyalarını barındıramaz. Bunun yerine özel bir yükleyici seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не може розміщувати файли .%@. Виберіть натомість власний вивантажувач."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法托管 .%@ 文件。请改为选择自定义上传器。"
          }
        }
      }
    },
