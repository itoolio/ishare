    "Converted recordings keep the GIF frame rate and size. Uploads are converted on the way out, so the saved video stays as it is." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converted recordings keep the GIF frame rate and size. Uploads are converted on the way out, so the saved video stays as it is."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ التسجيلات المحوّلة بمعدل إطارات GIF وحجمه. يتم تحويل الملفات المرفوعة أثناء الرفع، لذا يبقى الفيديو المحفوظ كما هو."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Converted recordings keep the GIF frame rate and size. Uploads are converted on the way out, so the saved video stays as it is."
          }
        },
        "cs" : {
          "stringUnit" : {
