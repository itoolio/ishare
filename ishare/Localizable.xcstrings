    "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب Apple Intelligence النص البديل على هذا الـ Mac استنادًا إلى النصوص والعناصر التي يتعرّف عليها ishare، ويُحفظ مع الرفع في السجل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Alternativtext wird auf diesem Mac von Apple Intelligence anhand der Texte und Objekte erstellt, die ishare erkennt, und mit dem Upload in deinem Verlauf gespeichert."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence escribe el texto alternativo en este Mac a partir del texto y los objetos que reconoce ishare, y se guarda con la subida en tu historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le texte alternatif est rédigé sur ce Mac par Apple Intelligence à partir du texte et des objets reconnus par ishare, puis enregistré avec l'envoi dans votre historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alt text is written on this Mac by Apple Intelligence from the text and objects ishare recognizes, and saved with the upload in your history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代替テキストは、ishareが認識したテキストとオブジェクトをもとにこのMac上でApple Intelligenceが作成し、アップロードとともに履歴に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대체 텍스트는 ishare가 인식한 텍스트와 객체를 바탕으로 이 Mac에서 Apple Intelligence가 작성하며, 업로드와 함께 기록에 저장됩니다."
          }
