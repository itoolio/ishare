        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 윈도우를 캡처하거나 이 앱이 맨 앞에 있을 때 적용되는 설정입니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu uygulamaların bir penceresini yakaladığınızda veya bu uygulamalar öndeyken uygulanan ayarlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштування, що застосовуються, коли ви знімаєте вікно цих програм або коли вони на передньому плані."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截取这些 App 的窗口或它们位于最前面时适用的设置。"
          }
        }
      }
    },
    "Share on Local Network" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المشاركة على الشبكة المحلية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im lokalen Netzwerk teilen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir en la red local"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partager sur le réseau local"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लोकल नेटवर्क पर शेयर करें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローカルネットワークで共有"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로컬 네트워크에서 공유"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Ağda Paylaş"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поширити в локальній мережі"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在本地网络上共享"
          }
        }
      }
    },
    "Share on Local Network serves a file from this Mac at a temporary link that only devices on the same network can open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدّم ميزة «المشاركة على الشبكة المحلية» ملفًا من جهاز Mac هذا عبر رابط مؤقت لا يمكن فتحه إلا من الأجهزة على الشبكة نفسها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Im lokalen Netzwerk teilen“ stellt eine Datei von diesem Mac über einen temporären Link bereit, den nur Geräte im selben Netzwerk öffnen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir en la red local sirve un archivo desde este Mac en un enlace temporal que solo pueden abrir los dispositivos de la misma red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Partager sur le réseau local » met à disposition un fichier de ce Mac via un lien temporaire que seuls les appareils du même réseau peuvent ouvrir."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“लोकल नेटवर्क पर शेयर करें” इस Mac से एक फ़ाइल को अस्थायी लिंक पर उपलब्ध कराता है, जिसे केवल उसी नेटवर्क के डिवाइस खोल सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ローカルネットワークで共有」は、同じネットワーク上のデバイスだけが開ける一時的なリンクで、このMacからファイルを提供します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘로컬 네트워크에서 공유’는 같은 네트워크의 기기에서만 열 수 있는 임시 링크로 이 Mac의 파일을 제공합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerel Ağda Paylaş, bir dosyayı bu Mac’ten yalnızca aynı ağdaki aygıtların açabileceği geçici bir bağlantıyla sunar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Поширити в локальній мережі» надає файл із цього Mac за тимчасовим посиланням, яке можуть відкрити лише пристрої в тій самій мережі."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“在本地网络上共享”会通过临时链接从这台 Mac 提供文件，只有同一网络中的设备才能打开。"
          }
        }
      }
    },
