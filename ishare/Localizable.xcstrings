    "Full-screen and region recordings only include sound from these apps. Recording a single window or app always uses that app's sound." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Full-screen and region recordings only include sound from these apps. Recording a single window or app always uses that app's sound."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتضمن تسجيلات ملء الشاشة والمنطقة إلا صوت هذه التطبيقات. أما تسجيل نافذة أو تطبيق واحد فيستخدم دائمًا صوت ذلك التطبيق."
          }
        },
        "ca" : {
