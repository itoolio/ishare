    "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتوقف التسجيلات تلقائيًا ويُحتفظ بها عند بلوغ حدٍّ ما أو عندما يتبقى أقل من 512 ميجابايت من مساحة القرص. تعرض عناصر التحكم في التسجيل الوقت المتبقي."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmen stoppen automatisch und werden behalten, wenn ein Limit erreicht ist oder weniger als 512 MB Speicherplatz frei sind. Die Aufnahmesteuerung zeigt die verbleibende Zeit an."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones se detienen solas y se conservan al alcanzar un límite o cuando quedan menos de 512 MB de espacio en disco. Los controles de grabación muestran el tiempo restante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements s'arrêtent d'eux-mêmes et sont conservés lorsqu'une limite est atteinte ou qu'il reste moins de 512 Mo d'espace disque. Les commandes d'enregistrement affichent le temps restant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "制限に達したとき、またはディスクの空き容量が512 MB未満になったとき、録画は自動的に停止して保存されます。録画コントロールに残り時間が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제한에 도달하거나 디스크 공간이 512MB 미만으로 남으면 녹화가 자동으로 중단되고 저장됩니다. 녹화 컨트롤에 남은 시간이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recordings stop on their own and are kept when a limit is reached or when less than 512 MB of disk space is left. The recording controls show the time left."
          }
        },
        "no" : {
          "stringUnit" : {
