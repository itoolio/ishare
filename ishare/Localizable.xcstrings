    "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوحة ملاحظات عائمة، مع ملقّن اختياري، لا يراها أحد سواك: إذ تُستبعد من كل تسجيل ولقطة شاشة. أظهرها أو أخفها من عناصر التحكم في التسجيل أو باستخدام اختصار."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein schwebendes Notizfenster mit optionalem Teleprompter, das nur du sehen kannst: Es erscheint in keiner Aufnahme und keinem Bildschirmfoto. Blende es über die Aufnahmesteuerung oder mit einem Kurzbefehl ein oder aus."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panel de notas flotante, con teleprompter opcional, que solo tú puedes ver: queda fuera de todas las grabaciones y capturas de pantalla. Muéstralo u ocúltalo desde los controles de grabación o con un atajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panneau de notes flottant, avec un prompteur facultatif, visible de vous seul : il est exclu de chaque enregistrement et capture d'écran. Affichez-le ou masquez-le depuis les commandes d'enregistrement ou avec un raccourci."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A floating notes panel, with an optional teleprompter, that only you can see: it is left out of every recording and screenshot. Show or hide it from the recording controls or with a shortcut."
