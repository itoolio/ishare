    "Default follows your After Capture settings. Uploading is on for presets unless you turn it off here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع الخيار الافتراضي إعدادات ما بعد الالتقاط. الرفع مفعّل للإعدادات المسبقة ما لم توقفه هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Standard“ folgt deinen Einstellungen für „Nach der Aufnahme“. Bei Vorgaben ist das Hochladen aktiviert, sofern du es hier nicht deaktivierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predeterminado sigue tus ajustes de Después de capturar. La subida está activada para los preajustes salvo que la desactives aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Par défaut » suit vos réglages Après la capture. L’envoi est activé pour les préréglages, sauf si vous le désactivez ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिफ़ॉल्ट आपकी कैप्चर के बाद की सेटिंग्स का पालन करता है। प्रीसेट के लिए अपलोड चालू रहता है, जब तक आप इसे यहाँ बंद न करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“デフォルト”はキャプチャ後の設定に従います。ここでオフにしない限り、プリセットではアップロードがオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘기본값’은 캡처 후 설정을 따릅니다. 여기서 끄지 않으면 프리셋의 업로드는 켜져 있습니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsayılan, Yakalama Sonrası ayarlarınızı izler. Burada kapatmadığınız sürece ön ayarlar için yükleme açıktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Типово» відповідає налаштуванням «Після знімка». Для пресетів вивантаження ввімкнено, якщо не вимкнути його тут."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“默认”遵循你的截图后设置。除非在此关闭，否则预设会开启上传。"
          }
        }
      }
    },
