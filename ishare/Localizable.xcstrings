          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "근처의 iPhone 또는 iPad로 사진 찍기, 문서 스캔 또는 스케치 추가"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
