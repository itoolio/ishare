    "Capture and Translate recognizes the text in an area and translates it on this Mac with Apple's Translation languages." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتعرّف ميزة التقاط وترجمة على النص في منطقة ما وتترجمه على هذا الـ Mac باستخدام لغات الترجمة من Apple."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Aufnehmen und übersetzen“ erkennt den Text in einem Bereich und übersetzt ihn auf diesem Mac mit den Sprachen von Apples „Übersetzen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturar y traducir reconoce el texto de un área y lo traduce en este Mac con los idiomas de Traducir de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Capturer et traduire » reconnaît le texte d'une zone et le traduit sur ce Mac avec les langues de Traduire d'Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कैप्चर करें और अनुवाद करें किसी क्षेत्र का टेक्स्ट पहचानता है और Apple की अनुवाद भाषाओं से इस Mac पर उसका अनुवाद करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「キャプチャして翻訳」は、領域内のテキストを認識し、Appleの翻訳言語を使ってこのMac上で翻訳します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'캡처 후 번역'은 영역의 텍스트를 인식하고 Apple 번역 언어를 사용해 이 Mac에서 번역합니다."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakala ve Çevir, bir alandaki metni tanır ve Apple'ın Çeviri dillerini kullanarak bu Mac'te çevirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Зняти й перекласти» розпізнає текст в області та перекладає його на цьому Mac за допомогою мов Перекладача Apple."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“捕获并翻译”会识别某个区域中的文本，并在这台 Mac 上使用 Apple 翻译语言进行翻译。"
          }
        }
      }
    },
