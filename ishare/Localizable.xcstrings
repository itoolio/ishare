          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare supprime les envois plus anciens que cette durée, vérifie chaque jour et à la sortie de veille de votre Mac, et ne supprime jamais les envois marqués « Conserver indéfiniment » dans votre historique."
          }
        },
