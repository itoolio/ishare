        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un preajuste agrupa un destino, destinos adicionales, un acortador de URL y ajustes propios tras la captura. Asígnale un atajo para capturar una región con él."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A preset bundles a destination, extra destinations, a URL shortener and after-capture overrides. Give it a shortcut to capture a region with it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un préréglage regroupe une destination, des destinations supplémentaires, un raccourcisseur d’URL et des réglages après capture spécifiques. Attribuez-lui un raccourci pour capturer une zone avec celui-ci."
          }
