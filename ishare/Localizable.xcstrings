    "Browse, copy, edit and delete everything you shared" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصفّح كل ما شاركته وانسخه وعدّله واحذفه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles Geteilte durchsuchen, kopieren, bearbeiten und löschen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora, copia, edita y elimina todo lo que has compartido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parcourez, copiez, modifiez et supprimez tout ce que vous avez partagé"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने जो कुछ भी शेयर किया है, उसे ब्राउज़ करें, कॉपी करें, संपादित करें और डिलीट करें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有したすべての項目を表示、コピー、編集、削除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유한 모든 항목을 탐색, 복사, 편집 및 삭제"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paylaştığınız her şeye göz atın, kopyalayın, düzenleyin ve silin"
          }
        },
        "uk" : {
          "stringUnit" : {
