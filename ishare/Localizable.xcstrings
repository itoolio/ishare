    "The shelf keeps your recent captures and recordings at the edge of the screen. Drag them into any app, or drop files onto it to collect them." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The shelf keeps your recent captures and recordings at the edge of the screen. Drag them into any app, or drop files onto it to collect them."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ الرف بالتقاطاتك وتسجيلاتك الأخيرة على حافة الشاشة. اسحبها إلى أي تطبيق، أو أفلت الملفات عليه لجمعها."
          }
        },
