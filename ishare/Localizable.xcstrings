    "%@ needs a client ID. Paste the client ID of your own app in the uploader settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج %@ إلى معرّف عميل. الصق معرّف العميل لتطبيقك الخاص في إعدادات أداة الرفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ benötigt eine Client-ID. Füge die Client-ID deiner eigenen App in den Uploader-Einstellungen ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita un ID de cliente. Pega el ID de cliente de tu propia app en los ajustes del cargador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nécessite un identifiant client. Collez l'identifiant client de votre propre app dans les réglages de l'uploader."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ को क्लाइंट ID चाहिए। अपलोडर सेटिंग्स में अपने ऐप का क्लाइंट ID पेस्ट करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にはクライアントIDが必要です。アップローダ設定に自分のアプリのクライアントIDを貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에는 클라이언트 ID가 필요합니다. 업로더 설정에 직접 등록한 앱의 클라이언트 ID를 붙여 넣으십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ için bir istemci kimliği gerekli. Kendi uygulamanın istemci kimliğini yükleyici ayarlarına yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ потребує ідентифікатор клієнта. Вставте ідентифікатор клієнта власного застосунку в налаштуваннях вивантажувача."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要客户端 ID。请在上传器设置中粘贴你自己应用的客户端 ID。"
          }
        }
      }
    },
