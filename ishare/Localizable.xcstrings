    "The private key couldn't be read (%@). Use an unencrypted or passphrase-protected OpenSSH Ed25519 or RSA key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة المفتاح الخاص (%@). استخدم مفتاح OpenSSH من نوع Ed25519 أو RSA غير مشفّر أو محميًا بعبارة مرور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der private Schlüssel konnte nicht gelesen werden (%@). Verwende einen unverschlüsselten oder mit Passphrase geschützten OpenSSH-Ed25519- oder -RSA-Schlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la clave privada (%@). Usa una clave OpenSSH Ed25519 o RSA sin cifrar o protegida con frase de contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé privée n'a pas pu être lue (%@). Utilisez une clé OpenSSH Ed25519 ou RSA non chiffrée ou protégée par une phrase secrète."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्राइवेट कुंजी पढ़ी नहीं जा सकी (%@)। बिना एन्क्रिप्शन वाली या पासफ़्रेज़ से सुरक्षित OpenSSH Ed25519 या RSA कुंजी का उपयोग करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "秘密鍵を読み込めませんでした（%@）。暗号化されていない、またはパスフレーズで保護されたOpenSSHのEd25519鍵かRSA鍵を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 키를 읽을 수 없습니다(%@). 암호화되지 않았거나 암호문으로 보호된 OpenSSH Ed25519 또는 RSA 키를 사용하십시오."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel anahtar okunamadı (%@). Şifrelenmemiş veya parolayla korunan bir OpenSSH Ed25519 ya da RSA anahtarı kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося прочитати приватний ключ (%@). Використовуйте незашифрований або захищений парольною фразою ключ OpenSSH Ed25519 чи RSA."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取私钥 (%@)。请使用未加密或受密码短语保护的 OpenSSH Ed25519 或 RSA 密钥。"
          }
        }
      }
    },
