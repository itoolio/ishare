    "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتذكر ishare مفتاح المضيف للخادم عند أول اتصال ويرفض الرفع إذا تغيّر المفتاح. قارن البصمة باستخدام ssh-keygen -lf على الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare merkt sich den Host-Schlüssel des Servers bei der ersten Verbindung und verweigert den Upload, wenn sich der Schlüssel ändert. Vergleiche den Fingerabdruck mit ssh-keygen -lf auf dem Server."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ishare recuerda la clave del host del servidor la primera vez que se conecta y se niega a subir si la clave cambia. Compara la huella con ssh-keygen -lf en el servidor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "ishare remembers the server's host key the first time it connects and refuses to upload if the key changes. Compare the fingerprint with ssh-keygen -lf on the server."
          }
        },
        "fr" : {
