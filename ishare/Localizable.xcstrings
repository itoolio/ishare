    "A recording preset bundles video, audio, webcam, overlay, pointer, zoom and limit settings. Recording with a preset uses them only for that recording." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A recording preset bundles video, audio, webcam, overlay, pointer, zoom and limit settings. Recording with a preset uses them only for that recording."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع إعداد التسجيل المسبق إعدادات الفيديو والصوت وكاميرا الويب والتراكب والمؤشر والتكبير والحدود. التسجيل باستخدام إعداد مسبق يطبّقها على ذلك التسجيل فقط."
          }
        },
        "ca" : {
          "stringUnit" : {
