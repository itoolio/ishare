          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede compartir el archivo porque ishare no puede leerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier ne peut pas être partagé car ishare ne peut pas le lire."
