---
import Base from "../layouts/Base.astro";
import { features, links } from "../site.js";
---
<Base>
  <section class="hero">
    <img class="hero-icon" src="/icon.png" alt="ishare app icon" width="132" height="132" />
    <h1>The definitive screen capture utility for macOS</h1>
    <p class="lead">Capture, record, annotate and upload from a Control Center style menu. Free, open source and built for macOS 15 and later, with Liquid Glass on macOS 26.</p>
    <div class="actions">
      <a class="button primary" href={links.appStore}>Download on the Mac App Store</a>
      <a class="button" href={links.dmg}>Download DMG</a>
    </div>
    <pre class="brew"><code>brew install --cask ishare</code></pre>
  </section>

  {features.map((feature, index) => (
    <section class={`feature ${index % 2 === 1 ? "reverse" : ""}`}>
      <div class="copy">
        <h2>{feature.title}</h2>
        <p>{feature.body}</p>
      </div>
      <img src={`/screenshots/${feature.image}.jpg`} alt={feature.title} loading={index === 0 ? "eager" : "lazy"} width="1600" height="1000" />
    </section>
  ))}

  <section class="grid">
    <div class="glass card"><h3>Keyboard first</h3><p>Global shortcuts for every capture, recording and upload, including capture-and-upload variants.</p></div>
    <div class="glass card"><h3>Shortcuts</h3><p>Capture, record, upload files and switch uploaders from the Shortcuts app and Siri.</p></div>
    <div class="glass card"><h3>Share extension</h3><p>Upload any image or video straight from the share menu of other apps.</p></div>
    <div class="glass card"><h3>Private by design</h3><p>No accounts, no analytics. Files only go where you upload them.</p></div>
    <div class="glass card"><h3>11 languages</h3><p>Translated by the community on <a href={links.crowdin}>Crowdin</a>, plus an Aussie mode that flips everything upside down.</p></div>
    <div class="glass card"><h3>Open source</h3><p>GPL-3.0 licensed and developed in the open on <a href={links.github}>GitHub</a>.</p></div>
  </section>
</Base>

<style>
  .hero { text-align: center; padding: 90px 0 60px; }
  .hero-icon { filter: drop-shadow(0 20px 40px rgba(124, 58, 237, 0.45)); }
  .hero h1 { font-size: clamp(36px, 6vw, 64px); margin: 20px auto 16px; max-width: 900px; }
  .lead { color: var(--muted); font-size: 19px; max-width: 720px; margin: 0 auto 30px; }
  .actions { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .brew { display: inline-block; margin-top: 26px; }
  .feature { display: grid; grid-template-columns: 1fr 1.6fr; gap: 48px; align-items: center; padding: 50px 0; }
  .feature.reverse { grid-template-columns: 1.6fr 1fr; }
  .feature.reverse .copy { order: 2; }
  .feature img { width: 100%; height: auto; border-radius: 18px; border: 1px solid var(--border); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5); }
  .feature h2 { font-size: 34px; margin: 0 0 12px; }
  .feature p { color: var(--muted); font-size: 17px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; padding-top: 50px; }
  .card { padding: 22px; }
  .card h3 { margin: 0 0 8px; }
  .card p { margin: 0; color: var(--muted); }
  @media (max-width: 820px) {
    .feature, .feature.reverse { grid-template-columns: 1fr; }
    .feature.reverse .copy { order: 0; }
  }
</style>
