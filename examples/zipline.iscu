{
	"name": "zipline",
	"requestURL": "https://your-zipline-host.com/api/upload",
	"headers": {
		"Authorization": "API_KEY",
	},
	"responseURL": "{{files[0].url}}",
	"fileFormName": "file",
	"viewCount": {
		"url": "https://your-zipline-host.com/api/user/files/{{files[0].id}}",
		"path": "views"
	}
}
